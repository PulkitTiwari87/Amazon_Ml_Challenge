r": null, "rationale": "Precision-heavy: false merges of two different businesses are more damaging than missed links; weights precision 2x over recall."}, {"id": "6ab10eb3b23ba_student_resource_student_resource_readme_macro", "label": "Per-entity macro-average scoring", "file_type": "concept", "source_file": "6ab10eb3b23ba_student_resource/student_resource/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "6ab10eb3b23ba_student_resource_student_resource_readme_singletons", "label": "Singleton handling (empty list scores 1.0)", "file_type": "concept", "source_file": "6ab10eb3b23ba_student_resource/student_resource/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Predicting any match for a true singleton scores 0.0, so correctly predicting no match earns full credit."}, {"id": "6ab10eb3b23ba_student_resource_student_resource_readme_leaderboards", "label": "Public and private leaderboards", "file_type": "concept", "source_file": "6ab10eb3b23ba_student_resource/student_resource/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Public uses a subset of test for live feedback; private uses the remainder and decides final rankings."}, {"id": "6ab10eb3b23ba_student_resource_student_resource_readme_package", "label": "Final submission package (team zip)", "file_type": "concept", "source_file": "6ab10eb3b23ba_student_resource/student_resource/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "6ab10eb3b23ba_student_resource_student_resource_readme_model_license", "label": "Model constraint: MIT/Apache 2.0 license, up to 8B parameters", "file_type": "concept", "source_file": "6ab10eb3b23ba_student_resource/student_resource/README.md", "source_location": null, "source_url": null,