{"nodes": [{"id": "amazon_ml_challenge_master", "label": "Amazon ML Challenge Master Knowledge Base", "file_type": "document", "source_file": "AMAZON_ML_CHALLENGE_MASTER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "amazon_ml_challenge_master_evidence_scope", "label": "Evidence scope: only two 2026 PDFs; E: drive not mounted", "file_type": "concept", "source_file": "AMAZON_ML_CHALLENGE_MASTER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Knowledge base is grounded only in the 2026 problem statement (8 pages) and guidelines (2 pages); the requested E:\\Amazon ML Challenge\\Docs drive was not mounted, so it is a verified 2026-focused reference with explicit historical gaps, not a review of all files."}, {"id": "amazon_ml_challenge_master_evidence_tags", "label": "Evidence tagging convention (OFFICIAL vs INFERENCE)", "file_type": "concept", "source_file": "AMAZON_ML_CHALLENGE_MASTER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Claims are labeled OFFICIAL when stated in official docs and INFERENCE when interpretation; prevents presenting speculation as rule."}, {"id": "amazon_ml_challenge_master_executive_summary", "label": "Executive summary of the 2026 ER task", "file_type": "concept", "source_file": "AMAZON_ML_CHALLENGE_MASTER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "amazon_ml_challenge_master_history_unverified", "label": "2021-2025 history not verified from available documents", "file_type": "concept", "source_file": "AMAZON_ML_CHALLENGE_MASTER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No basis to claim how the competition changed since 2021 or which methods repeatedly won; only the single 2026 edition is documented."}, {"id": "amazon_ml_challenge_master_judging_scope_conflict", "label": "Public/private leaderboard scope discrepancy (final ranking vs shortlisting)", "file_type": "concept", "source_file": "AMAZON_ML_CHALLENGE_MASTER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Problem statement says final decision is on the private leaderboard, guidelines say shortlisting uses both leaderboards; likely different stages but no combining formula is given."}, {"id": "amazon_ml_challenge_master_f05_formula", "label": "F0.5 formula and per-entity macro-average", "file_type": "concept", "source_file": "AMAZON_ML_CHALLENGE_MASTER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "F0.5 = 1.25*P*R/(0.25*P+R); beta=0.5 weights precision twice as much as recall, so false merges cost more than missed links; singleton empty list scores 1.0, any match on a singleton scores 0.0."}, {"id": "amazon_ml_challenge_master_pretrained_policy_unverified", "label": "Pretrained model / local LLM permission not verified", "file_type": "concept", "source_file": "AMAZON_ML_CHALLENGE_MASTER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "External lookup ban and MIT/Apache 2.0 <=8B rule do not settle whether arbitrary pretrained weights or data are allowed."}, {"id": "amazon_ml_challenge_master_threshold_separation", "label": "Tune candidate coverage and decision threshold separately", "file_type": "concept", "source_file": "AMAZON_ML_CHALLENGE_MASTER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "High candidate recall preserves possible true links; the final matcher should reject uncertain candidates to protect per-entity precision. Inference, not official."}, {"id": "amazon_ml_challenge_master_entity_safe_split", "label": "Entity/source-grouped holdout split to avoid leakage", "file_type": "concept", "source_file": "AMAZON_ML_CHALLENGE_MASTER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Splitting at entity/source group level prevents related records leaking across train and validation; official docs do not prescribe a split, this is a prudent safeguard."}, {"id": "amazon_ml_challenge_master_untouched_val", "label": "Keep a final validation set untouched during tuning", "file_type": "concept", "source_file": "AMAZON_ML_CHALLENGE_MASTER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reduces overfitting to iterative experimentation; inference."}, {"id": "amazon_ml_challenge_master_blocking_metrics", "label": "Blocking recall and candidate reduction ratio", "file_type": "concept", "source_file": "AMAZON_ML_CHALLENGE_MASTER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Candidate recall caps achievable final recall; reduction ratio measures candidate volume; both audited via candidate_pairs.tsv."}, {"id": "amazon_ml_challenge_master_slice_reports", "label": "Slice reports by country, source pairing, singleton status", "file_type": "concept", "source_file": "AMAZON_ML_CHALLENGE_MASTER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Report precision/recall/F0.5 by slice and inspect false merges separately because metric emphasizes precision."}, {"id": "amazon_ml_challenge_master_open_set_country", "label": "Open-set country handling (avoid hard-coding US/India)", "file_type": "concept", "source_file": "AMAZON_ML_CHALLENGE_MASTER.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "France is absen